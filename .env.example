# Settings MAEF reads from the environment. Every one is optional; defaults suit a single local machine.
# Never put secret values in this file or in the repository: export them in your shell or a chmod 600 file.
# Details: docs/RUNNING.md.

# Project and storage
# MAEF_HOME=/path/to/project          # project folder (default: nearest maef.toml, else the source checkout)
# MAEF_DB=runs/maef.db                # SQLite path, or a postgresql:// URL
# MAEF_ARTIFACTS_DIR=artifacts        # local result store
# MAEF_ARTIFACTS_URL=s3://bucket/prefix

# API
# MAEF_EXECUTION_ENABLED=1            # allow runs (off by default)
# MAEF_AUTHORING_ENABLED=1            # allow git-backed drafts
# MAEF_ACCOUNT_LIMIT_TOKENS=1000000   # default budget account limit
# MAEF_LEASE_SECONDS=60
# MAEF_RECORD_TRANSCRIPT=1            # store full transcripts as run artifacts

# Clients and workers (values come from `maef admin token create` / `maef admin worker create`)
# MAEF_API_URL=http://127.0.0.1:8000
# MAEF_API_TOKEN=
# MAEF_WORKER_CREDENTIAL=
# MAEF_WORKER_ALLOWED_CREDENTIALS=OPENROUTER_API_KEY   # extra env names the worker may resolve

# Sandbox
# MAEF_OCI_RUNTIME=podman

# Telemetry
# MAEF_OTLP_ENDPOINT=http://127.0.0.1:4318
